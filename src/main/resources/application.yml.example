spring:
  application:
    name: Movi_backend

  profiles:
    default: local

  jpa:
    open-in-view: false
    properties:
      hibernate:
        format_sql: true
        default_batch_fetch_size: 100

logging:
  level:
    com.movi_backend: debug

management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      probes:
        enabled: true
      show-details: never
  health:
    db:
      enabled: true
  metrics:
    tags:
      application: ${spring.application.name}

movi:
  transfer:
    minimum-amount: 1
    per-transfer-limit: 1000000
    daily-limit: 3000000
