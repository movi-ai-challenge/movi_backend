# 로컬 개발 환경 템플릿
#
# 사용법:
#   cp application-local.yml.example application-local.yml
#   그 뒤 password 등 값을 본인 환경에 맞게 채운다.
#
# application-local.yml 은 gitignore 대상이므로 커밋되지 않는다.
# 값을 바꿨는데 팀이 공유해야 하는 항목이라면 이 템플릿도 함께 갱신할 것.
#
# DB 준비:
#   CREATE DATABASE movi CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#   mysql -u root -p movi < docs/schema.sql

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/movi?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: 본인_로컬_MySQL_비밀번호
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    # validate: 엔티티와 schema.sql이 어긋나면 기동 시점에 잡아낸다.
    # 엔티티를 바꿨다면 docs/schema.sql도 함께 고치고 DB에 반영할 것.
    hibernate:
      ddl-auto: validate
    show-sql: true

logging:
  level:
    org.hibernate.SQL: debug
    org.hibernate.orm.jdbc.bind: trace

# 인증
#   dev-mode: true 면 JWT 없이 X-Dev-User-Id 헤더로 사용자를 지정할 수 있다.
#   인증 필터 구현 전 다른 파트가 API를 개발·테스트하기 위한 장치이며,
#   운영 환경에서는 반드시 false 여야 한다.
movi:
  openbanking:
    # mock = Mock 어댑터 (기본), real = 실 API 어댑터
    mode: mock
    base-url: https://testapi.openbanking.or.kr
    client-id: 오픈뱅킹_CLIENT_ID
    client-secret: 오픈뱅킹_CLIENT_SECRET
    # 오픈뱅킹 포털에 등록한 Callback URL 과 정확히 같아야 한다
    redirect-uri: http://localhost:8080/api/openbanking/callback
    scope: login inquiry transfer
    client-use-code: 오픈뱅킹_이용기관코드
  auth:
    dev-mode: true
    dev-user-id: 1
  kakao:
    rest-api-key: 카카오_REST_API_키
    client-secret: 카카오_Client_Secret_사용_시_입력
    redirect-uri: http://localhost:8080/api/v1/auth/kakao/callback
    secure-cookie: false
    # 로그인 완료 후 브라우저를 돌려보낼 프론트엔드 콜백 주소. 토큰을 쿼리파라미터로 붙여 리다이렉트한다.
    frontend-redirect-uri: http://localhost:3000/login/callback
  jwt:
    secret: 32바이트_이상의_로컬_JWT_서명_키를_입력하세요
  crypto:
    # openssl rand -base64 32 로 각각 생성한다.
    encryption-key: Base64_AES_키
    hash-key: Base64_HMAC_키
