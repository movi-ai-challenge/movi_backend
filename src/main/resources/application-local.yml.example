# 로컬 개발 환경 템플릿
#
# 사용법:
#   cp application-local.yml.example application-local.yml
#   그 뒤 password 등 값을 본인 환경에 맞게 채운다.
#
# application-local.yml 은 gitignore 대상이므로 커밋되지 않는다.
# 값을 바꿨는데 팀이 공유해야 하는 항목이라면 이 템플릿도 함께 갱신할 것.
#
# DB 준비:
#   CREATE DATABASE movi CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#   mysql -u root -p movi < docs/schema.sql

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/movi?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: 본인_로컬_MySQL_비밀번호
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    # validate: 엔티티와 schema.sql이 어긋나면 기동 시점에 잡아낸다.
    # 엔티티를 바꿨다면 docs/schema.sql도 함께 고치고 DB에 반영할 것.
    hibernate:
      ddl-auto: validate
    show-sql: true

logging:
  level:
    org.hibernate.SQL: debug
    org.hibernate.orm.jdbc.bind: trace
