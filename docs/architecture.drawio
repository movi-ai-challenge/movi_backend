        <mxCell id="e19" value="이미지 배포" style="exitX=0.07;exitY=0;entryX=0.038;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#546E7A;dashed=1;dashPattern=8 4;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#546E7A;" edge="1" parent="1" source="cicd" target="ec2">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;① 브라우저는 AI 에 직접 붙지 않는다&lt;/b&gt;  &lt;font style=&quot;font-size:10px;color:#5A6B7A&quot;&gt;설계 원칙&lt;/font&gt;&lt;br&gt;AI 는 movi-net 안에만 두고 인증과 검증을 백엔드가 쥔다.&lt;br&gt;직접 연결하면 누구나 인증 없이 STT 를 호출할 수 있다.&lt;br&gt;&lt;font color=&quot;#D32F2F&quot;&gt;&lt;b&gt;⚠ 현재 지켜지지 않는다 — 붉은 점선과 ④ 참조&lt;/b&gt;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;spacingLeft=10;spacingTop=2;fontSize=11;verticalAlign=top;fontColor=#5F4B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="545" width="340" height="94" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;② AI 는 해석만, 백엔드가 결정한다&lt;/b&gt;  &lt;font style=&quot;font-size:10px;color:#5A6B7A&quot;&gt;설계 원칙&lt;/font&gt;&lt;br&gt;AI 가 뽑은 금액·수취인은 사용자 입력과 똑같이 재검증한다.&lt;br&gt;AI 는 금융 DB 에 접근하지 않고 상태를 바꿀 권한도 없다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;spacingLeft=10;spacingTop=2;fontSize=11;verticalAlign=top;fontColor=#5F4B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="655" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;③ FDS 는 Fail-Closed&lt;/b&gt;  &lt;font style=&quot;font-size:10px;color:#5A6B7A&quot;&gt;설계 원칙&lt;/font&gt;&lt;br&gt;타임아웃·통신 오류·잘못된 응답은 모두 송금 중단.&lt;br&gt;평가하지 못하면 돈을 보내지 않는다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;spacingLeft=10;spacingTop=2;fontSize=11;verticalAlign=top;fontColor=#5F4B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="748" width="340" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;④ 현재 상태 — 원칙 ① 위반 중&lt;/b&gt;&lt;br&gt;nginx 가 /ai/ 경로를 그대로 프록시해 AI 내부 API 가&lt;br&gt;인증 없이 외부에 열려 있다. 붉은 점선이 그 경로다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFEBEE;strokeColor=#D32F2F;align=left;spacingLeft=10;spacingTop=2;fontSize=11;verticalAlign=top;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="40" y="831" width="340" height="86" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;⑤ 현재 상태 — RDS 가 인터넷에 열려 있다&lt;/b&gt;&lt;br&gt;RDS 엔드포인트가 퍼블릭 IP 로 해석되고, 사내망 밖 PC 에서&lt;br&gt;3306 직결이 성공한다. 보안그룹을 EC2 로만 좁혀야 한다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFEBEE;strokeColor=#D32F2F;align=left;spacingLeft=10;spacingTop=2;fontSize=11;verticalAlign=top;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="40" y="932" width="340" height="86" as="geometry" />
        </mxCell>
