spring:
  application:
    name: Movi_backend

  profiles:
    default: local

  jpa:
    open-in-view: false
    properties:
      hibernate:
        format_sql: true
        default_batch_fetch_size: 100

logging:
  level:
    com.movi_backend: debug

movi:
  fds:
    client-type: ${FDS_CLIENT_TYPE:mock}
    base-url: ${FDS_API_BASE_URL:http://localhost:8000}
    connect-timeout: 1s
    response-timeout: 3s
  voice:
    client-type: ${VOICE_CLIENT_TYPE:mock}
    base-url: ${VOICE_API_BASE_URL:http://localhost:8000}
    connect-timeout: 1s
    response-timeout: 10s
  transfer:
    minimum-amount: 1
    per-transfer-limit: 1000000
    daily-limit: 3000000
  notification:
    retry:
      enabled: true
      max-attempts: 3
      delay: 1m
      batch-size: 100
      scan-interval: 30s
management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      probes:
        enabled: true
      show-details: never
  health:
    db:
      enabled: true
  metrics:
    tags:
      application: ${spring.application.name}
